#!/bin/bash
# Called by the Supervisor before a backup (config.yaml backup_pre).
# The raw MariaDB files are excluded from the backup; this consistent dump is backed up instead.
set -euo pipefail
mkdir -p /data/backup
mariadb-dump -uroot --single-transaction --routines --triggers --events supla | gzip >/data/backup/supla.sql.gz.tmp
mv /data/backup/supla.sql.gz.tmp /data/backup/supla.sql.gz
